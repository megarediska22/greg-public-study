{
  "name": "greg-public-study",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "build": "npm run typecheck && vite build && node scripts/verify-production.mjs",
    "qa": "node scripts/start-local-qa.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "course:refresh": "node --experimental-strip-types scripts/generate-extension.mjs",
    "course:check-final": "node --experimental-strip-types scripts/generate-extension.mjs --final",
    "predev": "npm run course:refresh",
    "pretest": "npm run course:refresh",
    "prebuild": "npm run course:refresh"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~5.9.3",
    "vite": "^7.2.0"
  }
}
